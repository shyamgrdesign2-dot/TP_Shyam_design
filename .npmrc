# GitHub Packages — @dhspl-tatvacare/tesseract-ui (and future scoped packages).
# Token comes from the NODE_AUTH_TOKEN env var (local shell or CI build-arg).
# Never commit a real ghp_ token here.
@dhspl-tatvacare:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
