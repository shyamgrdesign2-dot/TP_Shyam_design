  "scripts": {
    "start": "craco start",
    "start:dev": "env-cmd -f .env.dev craco start",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 craco build && npm run sentry:sourcemaps",
    "lint:assets": "node scripts/check-no-raster-imports.js",
    "lint": "eslint --max-warnings=0 \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx}\"",
    "lint:errors": "eslint \"src/**/*.{js,jsx}\" --quiet --format unix",
    "prepare": "husky",
    "test": "craco test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "PLAYWRIGHT_HTML_OPEN=never playwright test --debug=cli",
    "eject": "react-scripts eject",
    "compress:models": "node scripts/compress-models.js",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org digicare-health-solutions-priv --project tatvapractice ./build && sentry-cli sourcemaps upload --org digicare-health-solutions-priv --project tatvapractice ${SENTRY_RELEASE:+--release \"$SENTRY_RELEASE\"} ./build",
    "start:chart": "cross-env PORT=5173 env-cmd --no-override -f .env.dev craco start"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "plugins": [
      "import"
    ],
    "rules": {
      "import/no-unresolved": [
        "error",
        {
          "ignore": [
            "three",
            "@react-three/fiber",
            "@react-three/drei",
            "lucide-react",
            "@radix-ui/react-alert-dialog",
            "@radix-ui/react-dialog",
            "@radix-ui/react-select",
            "@radix-ui/react-popover",
            "@radix-ui/react-tabs",
            "@ricky0123/vad-react",
            "@yudiel/react-qr-scanner",
            "pubnub",
            "@dhspl-tatvacare/tesseract-ui"
          ]
        }
      ]
    },
    "settings": {
      "import/resolver": {
        "node": {
          "extensions": [
            ".js",
            ".jsx",
            ".json",
            ".mjs",
            ".cjs"
          ],
          "moduleDirectory": [
            "node_modules"
          ]
        }
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@playwright/test": "^1.61.0",
    "@sentry/cli": "^2.53.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "cross-env": "^7.0.3",
    "env-cmd": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.11",
    "redux-devtools-extension": "^2.13.9"
  }
}
