# Runtime-only image. The React build now runs on the CI runner and this file does
# nothing but serve the result — see docs/build-time-optimisation-plan.md §8.
#
# Why the build moved out: actions/cache operates on the runner filesystem and cannot
# see inside a docker build, so the caches CRA produces were destroyed with the build
# stage on every deploy. Measured cost of that cold start: ~120s of a 354s build
# (run 32186452054). No node toolchain ships in the image any more either.
#
# The build context here is trimmed to build/ and nginx.conf by
# Dockerfile.runtime.dockerignore. Keep the two in sync — a file added to this
# Dockerfile that the ignore file excludes will fail the build with a confusing
# "file not found" rather than anything about ignore rules.
#
# The multi-stage Dockerfile is still in use by prod, qa and zy-preprod. Do not delete it.
FROM nginx:stable-alpine

COPY build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
